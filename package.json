  "description": "複数の天気予報ソースを統合し、より正確な天気予報を提供するWebアプリ",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
